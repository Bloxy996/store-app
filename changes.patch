diff --git a/src/features/editor/CodeMirrorEditor.css b/src/features/editor/CodeMirrorEditor.css
index ebb914f..69efb41 100644
--- a/src/features/editor/CodeMirrorEditor.css
+++ b/src/features/editor/CodeMirrorEditor.css
@@ -55,6 +55,23 @@
 .cm-heading-4,
 .cm-heading-5,
 .cm-heading-6 { font-size: 1.05em; color: var(--text-muted); }
+
+/* Callout lines while being edited as raw markdown (cursor inside the
+   block, so the wysiwyg widget steps aside) — same color groups as the
+   reading-view `.callout-*` classes, kept on the line itself so the
+   callout still looks like a callout instead of turning into plain text. */
+.cm-callout-line {
+  padding-left: 8px;
+  border-left: 3px solid var(--accent);
+  background: color-mix(in srgb, var(--accent) 10%, var(--bg-2));
+}
+.cm-callout-warn { border-left-color: #e0b95f; background: rgba(224, 185, 95, 0.1); }
+.cm-callout-danger { border-left-color: var(--danger); background: rgba(220, 90, 90, 0.1); }
+.cm-callout-tip { border-left-color: #6fbf73; background: rgba(111, 191, 115, 0.1); }
+.cm-callout-title-text {
+  font-weight: 600;
+  color: var(--text-normal);
+}
 .cm-wikilink,
 .cm-tag {
   color: var(--link-color);
