<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No permissions: the capture sheet is a Chrome Custom Tab (the browser
      does the networking) and the accessibility button is drawn by the
      system. <queries> only lets SparkCaptureActivity see which installed
      browsers support Custom Tabs.
    -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_spark"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <!-- Launcher screen: app icon + one-time setup buttons. -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The floating capture sheet (see SparkCaptureActivity.kt). Exported
          only for its storesparks:// scheme, which the page uses to say
          "done"/"open app"; singleTask so those land in onNewIntent and pop
          the Custom Tab above it.
        -->
        <activity
            android:name=".SparkCaptureActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.SparkTransparent">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="storesparks" />
            </intent-filter>
        </activity>

        <!--
          android:exported="true" is required here (and enforced since
          Android 12) because the widget host — the launcher — is what
          fires the APPWIDGET_UPDATE broadcast this receiver listens for;
          it's not a general-purpose exported surface, it only reacts to
          that one system broadcast (see SparkWidgetProvider.kt).
        -->
        <receiver
            android:name=".SparkWidgetProvider"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/spark_widget_info" />
        </receiver>

        <!--
          Quick Settings tile — opens the capture sheet.
          Must be exported + BIND_QUICK_SETTINGS_TILE-protected (system
          enforced, not a user-facing permission) for the shade to bind
          to it at all.
        -->
        <service
            android:name=".SparkTileService"
            android:exported="true"
            android:icon="@drawable/ic_spark"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!--
          The floating bubble: Android's own accessibility-button system.
          BIND_ACCESSIBILITY_SERVICE is system-enforced (only the OS may
          bind to it), and the config below requests ONLY the
          accessibility button — no window-content reading, no gesture
          capture (see accessibility_service_config.xml).
        -->
        <service
            android:name=".SparkAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
