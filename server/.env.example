# Google Cloud project's OAuth client (Web application type) — see
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must exactly match an "Authorized redirect URI" on that OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:8787/auth/callback

# store's frontend origin(s) — used for CORS and for where /auth/callback
# sends the browser back to after sign-in. Comma-separated if you run more
# than one (e.g. local dev + GitHub Pages).
FRONTEND_URL=http://localhost:5173

# 32+ char random string used to encrypt/sign the session cookie (which
# holds the refresh token). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

PORT=8787
